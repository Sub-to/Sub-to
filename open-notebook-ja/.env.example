# Open Notebook 日本語運用 — 環境変数テンプレート
# cp .env.example .env して編集してください。

# ============================================================
# 必須
# ============================================================
# API キーを暗号化して DB に保存するための秘密鍵。
# 16文字以上の任意の文字列に必ず変更してください。生成例:
#   openssl rand -base64 32
#
# 注意 1: あとから変更すると、保存済みの API キーが復号できなくなります。
#         最初に決めて変えないでください。
# 注意 2: 別の PC にデータ（surreal_data / notebook_data）をコピーして使う場合は、
#         コピー先でもこの鍵を同じ値にしてください。違う鍵だと API キーが
#         すべて使えなくなり、登録し直しになります。
#         鍵はパスワードマネージャなどに控えておくことをおすすめします。
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# ============================================================
# データベース（ローカル利用なら変更不要）
# ============================================================
# ネットワークに公開する場合は必ず変更してください。
SURREAL_USER=root
SURREAL_PASSWORD=root

# ============================================================
# 任意
# ============================================================
# バックグラウンド処理の同時実行数（既定 5）。
# Ollama などローカル LLM を使う場合は 1 にして順次処理させます。
OPEN_NOTEBOOK_WORKER_MAX_TASKS=5

# インスタンス全体にパスワードをかける場合（未設定なら認証なし）。
# 設定したら docker-compose.yml 側の該当行のコメントも外してください。
# OPEN_NOTEBOOK_PASSWORD=

# ------------------------------------------------------------
# AI プロバイダの API キーについて
# ------------------------------------------------------------
# ここには書きません。起動後に UI の「設定 → API キー」から登録してください。
# 環境変数での指定は上流で非推奨（DEPRECATED）扱いになっており、
# 将来のリリースで動作しなくなる可能性があります。
# UI から登録すると暗号化保存され、再起動なしでローテーションできます。
